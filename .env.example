# ═══════════════════════════════════════════════════════════════════════════════
# LOUMOO — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
#
# Copy to .env.local and fill in real values. .env.local is gitignored; NEVER
# commit real credentials.
#
# Variables marked [REQUIRED IN PRODUCTION] are enforced at boot: the server
# refuses to start in production without them rather than degrading into a
# permissive mode. See server/config/env.js -> assertProductionConfig().
# ═══════════════════════════════════════════════════════════════════════════════

# ── Server & Application ──────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development                       # development | staging | production | test
APP_NAME="LOUMOO Universal Commerce Platform"
APP_BASE_URL="http://localhost:8080"

# [REQUIRED IN PRODUCTION] An explicit origin list. "*" is rejected in
# production — it would let any site drive the API with a user's credentials.
CORS_ORIGINS="http://localhost:8080,https://loumoo.cm"

# Proxy trust is deployment-specific. Leave unset in local development so
# forwarded headers are ignored. Railway's public service has one ingress hop:
# set TRUST_PROXY=1 there. For another topology use an exact hop count or a
# comma-separated trusted proxy/CIDR list; never use "true"/"all" in production.
# TRUST_PROXY=1

# ── Clerk — the identity provider ─────────────────────────────────────────────
# Clerk owns authentication and email/phone verification. LOUMOO verifies the
# session token it issues and mirrors verification state into its own database.
#
# [REQUIRED IN PRODUCTION] Session verification is impossible without the
# secret key; without the publishable key the browser cannot reach Clerk.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_APP_ID="app_..."

# Svix signing secret for Clerk webhooks (RECOMMENDED in production, NOT a
# boot blocker). It is validated as a WARNING at boot — the flag below keeps
# the deployment available because an absent secret cannot be exploited, only
# unused:
#   Clerk Dashboard -> Configure -> Webhooks -> Add Endpoint
#     URL:    https://<your-domain>/api/v1/webhooks/clerk
#     Events: user.created, user.updated, user.deleted
#   then copy the "Signing Secret" (whsec_...) here.
# Without it the webhook endpoint answers 503 WEBHOOK_NOT_CONFIGURED: LOUMOO
# will not process unsigned identity events, because a forged one could
# create or delete any account.
CLERK_WEBHOOK_SECRET="whsec_..."

# Optional. Comma-separated origins a Clerk session token may be presented
# from ("azp" claim). Set this in production to reject tokens minted for a
# different site.
CLERK_AUTHORIZED_PARTIES="https://loumoo.cm"

# ── Phone verification ────────────────────────────────────────────────────────
# LOUMOO never simulates an SMS. When this is "none" the phone verification
# endpoints answer 503 PHONE_VERIFICATION_NOT_CONFIGURED with the requirement
# below, and the UI explains that the channel is unavailable.
#
#   none   Phone verification is unavailable (default).
#   clerk  Phone numbers are verified through Clerk. Requires a phone strategy
#          enabled in Clerk Dashboard -> Configure -> Email, Phone, Username,
#          and SMS credits on the Clerk plan.
PHONE_VERIFICATION_PROVIDER=none

# ── Supabase (database, storage) ──────────────────────────────────────────────
# [REQUIRED IN PRODUCTION] No database means no authoritative account state.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIs..."
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIs..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIs..."   # server only — never sent to a browser
SUPABASE_PROJECT_REF="<project-ref>"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_JWT_SECRET="<jwt-secret>"
DATABASE_DIRECT_HOST="db.<project-ref>.supabase.co:5432"

# Private bucket for listing media. Created by `npm run db:seed`. Objects are
# served only through short-lived signed URLs issued by the API.
SUPABASE_STORAGE_BUCKET="listing-media"

# Management API token (sbp_...), used ONLY by the migration scripts:
#   npm run db:migrate   -> applies server/infrastructure/database/migrations
#   npm run db:seed      -> syncs the taxonomy and creates the storage bucket
# Not needed by the running server; omit it from the runtime environment.
SUPABASE_MANAGEMENT_TOKEN="sbp_..."

# ── Redis (cache, rate limiting, idempotency) ─────────────────────────────────
# Required for protected production API traffic. Without it the production
# limiter fails closed rather than falling back to process-local memory, which
# would not share limits across replicas. It remains optional for development.
REDIS_URL="redis://default:<password>@<host>:<port>"

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN="https://<key>@<org>.ingest.sentry.io/<project>"

# PostHog ingestion needs a PROJECT key (phc_...). A personal API key (phx_...)
# is for the management API and is rejected by the capture endpoint, so the
# server disables analytics and logs one warning rather than erroring per event.
POSTHOG_API_KEY="phc_..."
POSTHOG_HOST="https://us.i.posthog.com"

# ── Transactional email ───────────────────────────────────────────────────────
# Used for welcome and notification mail. Verification email is sent by Clerk,
# not from here.
RESEND_API_KEY="re_..."

# ── Optional integrations ─────────────────────────────────────────────────────
AISSTREAM_API_KEY="<aisstream-api-key>"     # maritime tracking (aisstream.io websocket)
# OpenAI-compatible LLM endpoint for listing-AI suggestions. Leave empty to use
# the deterministic offline baseline; must point at a /v1/chat/completions API.
AISSTREAM_BASE_URL=""                  # e.g. https://api.openai.com/v1
AISSTREAM_MODEL="gpt-4o-mini"          # model id for AISSTREAM_BASE_URL
ELEVENLABS_API_KEY=""                      # server only; use the rotated key
ELEVENLABS_AGENT_ID="agent_0101m41ry4pmf0nsrszhnn01hx73"
SEARCH_ENABLED="false"                    # enable after migration 014
OPENAI_API_KEY=""                          # optional photo search / structured text assistant
SEARCH_AI_MODEL=""                         # image + structured-output capable Responses model
GOOGLE_APP_PASSWORD="<google-app-password>" # SMTP fallback
GITHUB_TOKEN="github_pat_..."
NETLIFY_AUTH_TOKEN="nfp_..."

# ── Test harness (development only) ───────────────────────────────────────────
# Enables the `loumoo_test:<secret>:<clerkUserId>` bearer scheme so the
# automated suites can authenticate without a live Clerk browser session.
#
# It is HARD-DISABLED whenever NODE_ENV=production, regardless of value, and
# setting it in production is reported as a misconfiguration that blocks boot.
# tests/unit/auth_bypass.test.js asserts both. Leave unset outside CI.
# LOUMOO_TEST_AUTH_SECRET="<random-hex>"
