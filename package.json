{
  "name": "loumoo-universal-commerce",
  "version": "1.0.0",
  "description": "LOUMOO — Omnichannel Multi-Vertical Universal Commerce Ecosystem",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node server/index.js",
    "start": "node server/index.js",
    "test": "node tests/run_all.js",
    "test:services": "node scripts/verify_backend_services.js",
    "verify:screens": "python verify_screens.py",
    "verify:runtime": "node verify_runtime.js",
    "build:frontend": "node scripts/build_combi.js && python build_redesign.py",
    "build:combi": "node scripts/build_combi.js",
    "test:search": "node tests/search/run.js",
    "test:search:ui": "node tests/search/ui.test.js",
    "test:performance": "node tests/unit/frontend_performance.test.js",
    "test:unit": "node tests/run_all.js",
    "test:security": "node tests/integration/api_security.test.js",
    "test:journey": "node tests/integration/seller_journey.test.js",
    "test:uploads": "node tests/integration/upload_transactions.test.js",
    "db:migrate": "node scripts/apply_migration.js --all",
    "db:seed": "node scripts/seed_taxonomy.js",
    "db:purge-test-data": "node scripts/purge_test_data.js"
  },
  "keywords": [
    "loumoo",
    "commerce",
    "cemac",
    "supabase",
    "clerk",
    "redis",
    "sentry"
  ],
  "author": "LOUMOO Core Engineering Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@clerk/backend": "^1.24.1",
    "@elevenlabs/client": "1.26.0",
    "@sentry/node": "^8.45.0",
    "@supabase/supabase-js": "^2.48.1",
    "@vercel/analytics": "^2.0.1",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "ipaddr.js": "^1.9.1",
    "nodemailer": "^9.1.0",
    "posthog-node": "^4.4.1",
    "resend": "^4.1.1",
    "serverless-http": "^3.2.0",
    "svix": "^1.99.1",
    "ws": "^8.18.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "esbuild": "0.28.1",
    "nodemon": "^3.1.9",
    "playwright": "1.62.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
