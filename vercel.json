{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "node scripts/assemble_public.js",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "{src/data/**,data/**}"
    }
  },
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/app",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/Commerce App.dc.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/Commerce%20App.dc.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/seller",
      "destination": "/sell",
      "permanent": true
    },
    {
      "source": "/seller/onboarding",
      "destination": "/sell/onboarding",
      "permanent": true
    },
    {
      "source": "/seller/create-store",
      "destination": "/sell/create-store",
      "permanent": true
    },
    {
      "source": "/login",
      "destination": "/sign-in",
      "permanent": true
    },
    {
      "source": "/signin",
      "destination": "/sign-in",
      "permanent": true
    },
    {
      "source": "/signup",
      "destination": "/onboarding",
      "permanent": true
    },
    {
      "source": "/sign-up",
      "destination": "/onboarding",
      "permanent": true
    },
    {
      "source": "/listing/:id([A-Za-z0-9_-]+)",
      "destination": "/product/:id",
      "permanent": true
    },
    {
      "source": "/announce/:id([A-Za-z0-9_-]+)",
      "destination": "/announcements/:id",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin",
      "destination": "/superadmin/index.html"
    },
    {
      "source": "/superadmin",
      "destination": "/superadmin/index.html"
    },
    {
      "source": "/marketplace",
      "destination": "/index.html"
    },
    {
      "source": "/marketplace/filters",
      "destination": "/index.html"
    },
    {
      "source": "/marketplace/voice",
      "destination": "/index.html"
    },
    {
      "source": "/marketplace/visual",
      "destination": "/index.html"
    },
    {
      "source": "/marketplace/visual/scan",
      "destination": "/index.html"
    },
    {
      "source": "/marketplace/visual/results",
      "destination": "/index.html"
    },
    {
      "source": "/marketplace/categories",
      "destination": "/index.html"
    },
    {
      "source": "/marketplace/category/:category([A-Za-z0-9_-]+)",
      "destination": "/index.html"
    },
    {
      "source": "/marketplace/best-picks",
      "destination": "/index.html"
    },
    {
      "source": "/marketplace/free-day",
      "destination": "/index.html"
    },
    {
      "source": "/compare",
      "destination": "/index.html"
    },
    {
