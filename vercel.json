      "destination": "/index.html"
    },
    {
      "source": "/store/:slug([A-Za-z0-9_-]+)",
      "destination": "/index.html"
    },
    {
      "source": "/announcements",
      "destination": "/index.html"
    },
    {
      "source": "/announcements/campaigns",
      "destination": "/index.html"
    },
    {
      "source": "/announcements/:id([A-Za-z0-9_-]+)",
      "destination": "/index.html"
    },
    {
      "source": "/travel",
